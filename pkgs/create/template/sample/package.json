{
  "name": "my-video",
  "private": true,
  "type": "module",
  "scripts": {
    "irodoru": "docker run --rm -p 127.0.0.1:8080:8080 ghcr.io/kanade-k-1228/irodoru:latest-mf",
    "voicevox": "docker run --rm -p 127.0.0.1:50021:50021 voicevox/voicevox_engine:cpu-latest",
    "preview": "mekuru-compiler --serve --run 'bun --hot src/main.tsx' .mekuru/main.xml",
    "build": "bun src/main.tsx && mekuru-compiler .mekuru/main.xml -o video.mp4",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@mekuru/tsx": "^0.2.0",
    "@mekuru/core": "^0.2.0",
    "@mekuru/speech": "^0.2.0",
    "typescript": "7.0.2",
    "@mekuru/narrator": "^0.2.0"
  }
}
