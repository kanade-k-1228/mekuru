{
  "name": "@mekuru/cli",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanade-k-1228/mekuru.git",
    "directory": "pkgs/cli"
  },
  "homepage": "https://github.com/kanade-k-1228/mekuru/blob/main/pkgs/cli/README.md",
  "description": "The commands of Mekuru Movie Maker: mekuru-server (the viewer in the browser, which can run the script with --run) and mekuru-compiler (XML \u2192 video, a prebuilt binary for each platform)",
  "type": "module",
  "bin": {
    "mekuru-server": "./src/mekuru-server.ts",
    "mekuru-compiler": "./src/mekuru-compiler.ts"
  },
  "files": [
    "src",
    "viewer"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "@mekuru/protocol": "workspace:^",
    "@mekuru/platform": "workspace:^"
  },
  "exports": {
    "./*": "./*",
    "./compiler": "./src/compiler.ts",
    "./server": "./src/server.ts",
    "./timeline": "./src/timeline.ts"
  }
}
