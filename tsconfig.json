{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "@mekuru/core",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["pkgs/*/src", "pkgs/*/test", "scripts", "example/src", "example/scripts"],
  "exclude": ["pkgs/viewer", "pkgs/create/template"]
}
