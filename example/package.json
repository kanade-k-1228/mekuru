{
  "name": "mekuru-tutorial",
  "private": true,
  "type": "module",
  "scripts": {
    "irodoru": "docker run --rm -p 127.0.0.1:8080:8080 ghcr.io/kanade-k-1228/irodoru:latest-mf",
    "voicevox": "docker run --rm -p 127.0.0.1:50021:50021 voicevox/voicevox_engine:cpu-latest",
    "portrait": "mekuru-psd tutorial/assets/source/zundamon.psd --out tutorial/assets/character/zundamon",
    "preview": "bun run portrait && mekuru-compiler --serve --run 'bun --tsconfig-override ../tsconfig.json --hot src/main.tsx' .mekuru/main.xml",
    "build": "bun run portrait && bun --tsconfig-override ../tsconfig.json src/main.tsx && mekuru-compiler .mekuru/main.xml -o tutorial.mp4",
    "export:vscode": "ffmpeg -hide_banner -y -i tutorial.mp4 -map 0:v:0 -map 0:a:0 -c:v copy -c:a libmp3lame -b:a 192k -movflags +faststart tutorial.vscode.mp4",
    "upload:youtube": "mekuru-youtube",
    "upload:niconico": "mekuru-niconico",
    "portrait:source": "bun scripts/create-portrait.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@mekuru/tsx": "workspace:*",
    "@mekuru/core": "workspace:*",
    "@mekuru/upload": "workspace:*",
    "typescript": "7.0.2",
    "@mekuru/narrator": "workspace:*",
    "@mekuru/speech": "workspace:*",
    "ag-psd": "^31.0.3",
    "sharp": "^0.35.5"
  }
}
