{
  "name": "mekuru-tutorial",
  "private": true,
  "type": "module",
  "scripts": {
    "portrait": "bun scripts/portrait.ts",
    "preview": "bun scripts/portrait.ts && mekuru-server --run 'bun --tsconfig-override ../tsconfig.json --hot src/main.tsx' .mekuru/main.xml",
    "build": "bun scripts/portrait.ts && bun --tsconfig-override ../tsconfig.json src/main.tsx && mekuru-compiler .mekuru/main.xml -o tutorial.mp4",
    "upload:youtube": "mekuru-youtube",
    "upload:niconico": "mekuru-niconico"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@mekuru/core": "workspace:*",
    "@mekuru/cli": "workspace:*",
    "@mekuru/niconico": "workspace:*",
    "@mekuru/portrait": "workspace:*",
    "@mekuru/voisona": "workspace:*",
    "@mekuru/youtube": "workspace:*",
    "typescript": "7.0.2"
  }
}
