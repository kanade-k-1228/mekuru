{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "@mekuru/core",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "declaration": true
  },
  "include": ["${configDir}/src"]
}
